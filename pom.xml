<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>hello-world-java</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Hello World — Java 11</name>
    <description>
        Hello World project compatible with Java 11.
        Uses only features available in Java 11.
    </description>

    <properties>
        <java.version>11</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            JUnit 5 (Jupiter) test framework — scoped to `test` only so that
            no third-party code is bundled into the runtime JAR produced by
            the maven-jar-plugin, preserving the standard-library-only
            posture of the application runtime (AAP §0.3.1.1, §0.6.2.4).

            The split-artifact model requires BOTH artifacts:
              • junit-jupiter-api    — annotations (@Test, @BeforeEach, …)
                                       and assertion APIs used by test code.
              • junit-jupiter-engine — JUnit Platform engine that Surefire
                                       delegates to for actual execution.
            Omitting the engine would cause Surefire to report
            "No tests found" because no platform engine would be on the
            test classpath.

            Version 5.10.2 is identical to the version used in
            repo1-java21/pom.xml, ensuring cross-submodule test-tier
            parity. JUnit 5.10.x supports Java 8+, comfortably within the
            Java 11 baseline declared in <properties>.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            User-mandated test root override (AAP §0.6.2.2).
            The user's explicit instruction "Test code should be organized
            in test/ folder" supersedes Maven's default convention of
            `src/test/java`. Resolved by Maven as `${basedir}/test/java`.
        -->
        <testSourceDirectory>test/java</testSourceDirectory>

        <plugins>

            <!-- Enforce minimum Java version at build time -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[11,)</version>
                                    <message>This project requires Java 11 or later.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compile with release 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- Package as executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.example.HelloWorld</mainClass>
                        </manifest>
                    </archive>
                    <finalName>hello-world</finalName>
                </configuration>
            </plugin>

            <!--
                Run JUnit 5 tests during the `test` phase (AAP §0.3.1.1,
                §0.6.2.6). Surefire 3.2.5 natively discovers JUnit 5 tests
                via the JUnit Platform when junit-jupiter-engine is on the
                test classpath, so no extra <configuration> is required.
                Surefire's default include patterns (`**/*Test.java`,
                `**/Test*.java`, `**/*Tests.java`) match the test class
                `HelloWorldFeatureTest.java`, so no <includes> override
                is required either.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

        </plugins>
    </build>

</project>
